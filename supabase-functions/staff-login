import { serve } from 'https://deno.land/std@0.168.0/http/server.ts'
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2'

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Methods': 'POST, OPTIONS',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',
}

const supabaseUrl = Deno.env.get('SUPABASE_URL')!
const supabaseServiceKey = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!
const supabase = createClient(supabaseUrl, supabaseServiceKey)

serve(async (req) => {
  if (req.method === 'OPTIONS') {
    return new Response('ok', { headers: corsHeaders })
  }
  if (req.method !== 'POST') {
    return new Response('Method not allowed', { status: 405, headers: corsHeaders })
  }

  try {
    const { pin, role } = await req.json()
    if (!pin || !role) {
      return new Response(
        JSON.stringify({ error: 'PIN and role are required' }),
        { status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
      )
    }

    // staff_pins has RLS enabled with zero policies — this query only works
    // because we're using the service role key here, which bypasses RLS.
    const { data: match, error: matchError } = await supabase
      .from('staff_pins')
      .select('staff_id')
      .eq('pin', pin)
      .eq('role', role)
      .maybeSingle()

    if (matchError) {
      console.error('staff_pins lookup error:', matchError)
      return new Response(
        JSON.stringify({ error: 'Could not verify PIN right now.' }),
        { status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
      )
    }

    if (!match) {
      // Same message regardless of whether the PIN or role was wrong —
      // don't give an attacker information about which part failed.
      return new Response(
        JSON.stringify({ error: 'Incorrect PIN for this login type.' }),
        { status: 401, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
      )
    }

    // Fetch the matching staff profile (name, role, permissions) from
    // kv_store — this value no longer contains any pin field.
    const { data: staffRow, error: staffError } = await supabase
      .from('kv_store')
      .select('value')
      .eq('key', 'staff')
      .maybeSingle()

    if (staffError || !staffRow) {
      console.error('kv_store staff lookup error:', staffError)
      return new Response(
        JSON.stringify({ error: 'Could not load your account details.' }),
        { status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
      )
    }

    const staffMember = (staffRow.value || []).find((s: any) => s.id === match.staff_id)
    if (!staffMember) {
      return new Response(
        JSON.stringify({ error: 'Your account could not be found. Ask an admin to check your staff record.' }),
        { status: 404, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
      )
    }

    return new Response(
      JSON.stringify({ user: staffMember }),
      { headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
    )
  } catch (error) {
    console.error('staff-login error:', error)
    return new Response(
      JSON.stringify({ error: error.message || 'Internal server error' }),
      { status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
    )
  }
})
